rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'GnpVhd5SRMQGxm0lExe5Ycd6btf2' ||
        request.auth.uid == 'FoQAHsSnbdeHayMSl85wR5EliYm1'
      );
    }

    function isAuth() {
      return request.auth != null;
    }

    function onlyEngagementFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['likes', 'likedBy', 'comments', 'repostCount', 'viewCount', 'shareCount']);
    }

    // A comment can only ever be mutated to add/remove a like (any authed user) — nothing else.
    function onlyCommentLike() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['likes', 'likedBy']);
    }

    // The comment's own author may edit its text (and the edited marker) — nothing else.
    function commentTextEditByAuthor() {
      return request.auth.uid == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']);
    }

    // Validates a text field exists, is a string, and is within maxLen characters
    function validText(field, maxLen) {
      return field in request.resource.data
          && request.resource.data[field] is string
          && request.resource.data[field].size() <= maxLen;
    }

    // ── Posts ──
    match /posts/{postId} {
      allow read: if true; // public: logged-out visitors can browse the feed read-only
      allow create: if isAuth()
                    && request.resource.data.authorId == request.auth.uid
                    && (!('text' in request.resource.data) || validText('text', 2200))
                    && request.resource.data.keys().size() <= 30;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.authorId ||
        onlyEngagementFields() ||
        isAdmin()
      );
      allow delete: if isAuth() && (request.auth.uid == resource.data.authorId || isAdmin());

      match /comments/{commentId} {
        allow read: if true; // public: comments visible to logged-out browsers
        allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isAuth() && (request.auth.uid == resource.data.authorId || isAdmin());
        allow update: if isAuth() && (onlyCommentLike() || commentTextEditByAuthor());
      }

      match /reactions/{userId} {
        allow read: if true; // public: like state is a public social signal
        allow write: if isAuth() && request.auth.uid == userId;
      }

      // Story "seen by" — each viewer records their OWN view; only the story's
      // author (or an admin) can read the list of who viewed it.
      match /views/{userId} {
        allow create, update: if isAuth() && request.auth.uid == userId;
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid || isAdmin()
        );
      }
    }

    // ── Reels ──
    match /reels/{reelId} {
      allow read: if true; // public: logged-out visitors can browse reels read-only
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.authorId ||
        onlyEngagementFields() ||
        isAdmin()
      );
      allow delete: if isAuth() && (request.auth.uid == resource.data.authorId || isAdmin());

      match /comments/{commentId} {
        allow read: if true; // public: reel comments visible to logged-out browsers
        allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isAuth() && (request.auth.uid == resource.data.authorId || isAdmin());
        allow update: if isAuth() && (onlyCommentLike() || commentTextEditByAuthor());
      }
    }

    // ── Users ──
    match /users/{userId} {
      // FIX: require auth to read — prevents unauthenticated access to emails
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId;
      // Owner may update their own profile, but NOT the server-authoritative fields
      // (ban state + the follower/view counters that gate creator-fund payouts).
      // Those are written only by the Admin SDK (follow/record-view/moderation routes).
      allow update: if isAuth() && (
        isAdmin() ||
        (request.auth.uid == userId
         && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['banned','banType','banUntil','followersCount','followingCount','totalViews','violations']))
      );
      allow delete: if isAuth() && (request.auth.uid == userId || isAdmin());

      // Public profile — readable by all authenticated users
      match /public/{doc} {
        allow read: if true; // public: profile cards visible to logged-out browsers
        allow create, update: if isAuth() && (request.auth.uid == userId || isAdmin());
        allow delete: if isAuth() && (request.auth.uid == userId || isAdmin());
      }

      // FIX: Followers — the FOLLOWER (docId) writes their own entry, not the followed user
      match /followers/{followerId} {
        allow read: if isAuth();
        allow write: if isAuth() && request.auth.uid == followerId;
      }

      // FIX: BlockedBy — the BLOCKER (docId) writes the blocked-by entry
      match /blockedBy/{blockerId} {
        allow read: if isAuth() && (request.auth.uid == userId || request.auth.uid == blockerId || isAdmin());
        allow write: if isAuth() && request.auth.uid == blockerId;
      }

      // Presence — own user writes, anyone authenticated reads (needed for chat online status)
      match /presence/{docId} {
        allow read: if isAuth();
        allow write: if isAuth() && request.auth.uid == userId;
      }

      // Settings — strictly private
      match /settings/{docId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }

      // Subscriptions — buyer writes their own, creator can read theirs
      match /subscriptions/{creatorId} {
        allow read: if isAuth() && (request.auth.uid == userId || request.auth.uid == creatorId || isAdmin());
        allow write: if isAuth() && request.auth.uid == userId;
      }

      // Earnings — read by creator/admin; validated client writes (tips, subs) + admin
      match /earnings/{docId} {
        allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
        // Server-authoritative: earnings are written only by the Stripe webhook / verify
        // routes / payout cron via the Admin SDK (which bypasses rules). Clients must NOT
        // be able to forge earnings, so no client create/update/delete.
        allow write: if false;
      }

      // PPV media URLs — the real media URL for a paid post is kept here (off the public
      // post doc) so the paywall can't be bypassed by reading the doc. Readable ONLY by the
      // author or a user who has actually unlocked that post; written by the author.
      match /ppvMedia/{postId} {
        allow read: if isAuth() && (
          request.auth.uid == userId ||
          exists(/databases/$(database)/documents/posts/$(postId)/ppvUnlocks/$(request.auth.uid)) ||
          exists(/databases/$(database)/documents/reels/$(postId)/ppvUnlocks/$(request.auth.uid))
        );
        allow write: if isAuth() && request.auth.uid == userId;
      }

      // Monthly view tracking — server-authoritative (written by the record-view
      // route via the Admin SDK). Users must NOT write their own view counts: they
      // feed the creator-fund payout math. Read-only for the owner/admin.
      match /monthlyViews/{month} {
        allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin();
      }

      // Private subcollections — owner-only read/write
      match /blocked/{docId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }

      match /bookmarks/{docId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }

      match /following/{docId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }

      match /pushTokens/{docId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }

      match /workoutLogs/{docId} {
        allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
        allow write: if isAuth() && request.auth.uid == userId;
      }

      match /workoutPlan/{docId} {
        allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
        allow write: if isAuth() && request.auth.uid == userId;
      }

      // Running routes — anyone authenticated can read (for PR display on profiles)
      match /runningRoutes/{docId} {
        allow read: if isAuth();
        allow write: if isAuth() && request.auth.uid == userId;
      }

      // Cycling routes — anyone authenticated can read
      match /cyclingRoutes/{docId} {
        allow read: if isAuth();
        allow write: if isAuth() && request.auth.uid == userId;
      }

      // Progress photos — private to the owner (FIX: was denied by the read-only catch-all)
      match /progressPhotos/{docId} {
        allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
        allow write: if isAuth() && request.auth.uid == userId;
      }

      // Mood logs — private to the owner (FIX: was denied by the read-only catch-all)
      match /moodLogs/{docId} {
        allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
        allow write: if isAuth() && request.auth.uid == userId;
      }

      // Catch-all: read-only for owner/admin — write is INTENTIONALLY omitted here
      // so the catch-all never silently bypasses the validated rules above (earnings, etc.)
      match /{subcollection}/{docId} {
        allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ── Ghost Workouts (FIX: was missing, defaulted to deny) ──
    match /ghostWorkouts/{workoutId} {
      allow read: if true; // public: browseable by logged-out visitors
      allow create: if isAuth() && request.resource.data.hostId == request.auth.uid;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.hostId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessionCount']) ||
        isAdmin()
      );
      allow delete: if isAuth() && (request.auth.uid == resource.data.hostId || isAdmin());

      match /sessions/{sessionId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }

      // PPV unlock records — written server-side (Admin SDK); the buyer/host may read
      // their own so a returning buyer isn't shown the paywall again. (FIX: was denied)
      match /purchases/{buyerId} {
        allow read: if isAuth() && (request.auth.uid == buyerId || isAdmin());
        allow write: if false;
      }
    }

    // ── Ads ──
    match /ads/{adId} {
      allow read: if true; // public: feed ads visible to logged-out browsers
      allow create: if isAuth() && request.resource.data.advertiserId == request.auth.uid;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.advertiserId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impressions', 'clicks']) ||
        isAdmin()
      );
      allow delete: if isAuth() && (request.auth.uid == resource.data.advertiserId || isAdmin());
    }

    // ── Chats ──
    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && validText('text', 1000)
          && request.resource.data.keys().size() <= 5;
        allow update, delete: if false;
      }
    }

    // ── Scheduled Classes (FIX: update now admin-only) ──
    match /scheduledClasses/{classId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();

      match /rsvps/{userId} {
        allow read: if isAuth();
        allow write: if isAuth() && request.auth.uid == userId;
      }
    }

    // ── Challenges ──
    match /challenges/{challengeId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      // Any joiner may bump nodeCount when they add a node (FIX: was author-only, so
      // joining someone else's chain threw).
      allow update: if isAuth() && (
        request.auth.uid == resource.data.authorId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nodeCount']) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /nodes/{nodeId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if false;
      }
    }

    // ── Live Streams ──
    match /streams/{streamId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.hostId == request.auth.uid;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.hostId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount']) ||
        isAdmin()
      );
      allow delete: if isAuth() && (request.auth.uid == resource.data.hostId || isAdmin());

      match /gifts/{docId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      match /pulse/{docId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }

      match /race/{docId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }

      match /raceScores/{docId} {
        allow read: if isAuth();
        allow write: if isAuth() && request.auth.uid == docId;
      }
    }

    // ── Podcasts (FIX: was missing, defaulted to deny — uploads/plays/reads all failed) ──
    match /podcasts/{episodeId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.hostId == request.auth.uid;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.hostId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays', 'likes', 'likedBy']) ||
        isAdmin()
      );
      allow delete: if isAuth() && (request.auth.uid == resource.data.hostId || isAdmin());

      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isAuth() && (request.auth.uid == resource.data.authorId || isAdmin());
        allow update: if false;
      }
    }

    // ── Live Podcasts (doc id = host uid) ──
    match /livePodcasts/{hostId} {
      allow read: if isAuth();
      // Host owns the show; any listener may bump listenerCount join/leave. (FIX: was
      // host-only, so the live listener count never moved.)
      allow create: if isAuth() && request.auth.uid == hostId;
      allow update: if isAuth() && (
        request.auth.uid == hostId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['listenerCount']) ||
        isAdmin()
      );
      allow delete: if isAuth() && (request.auth.uid == hostId || isAdmin());

      // Live chat (FIX: subcollection had no rule → chat never loaded or sent)
      match /chat/{msgId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
        allow update: if false;
        allow delete: if isAuth() && (request.auth.uid == hostId || isAdmin());
      }
    }

    // ── Time Capsules (FIX: was missing, defaulted to deny) ──
    match /capsules/{capsuleId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.authorId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unlocked', 'unlockedAt']) ||
        isAdmin()
      );
      allow delete: if isAuth() && (request.auth.uid == resource.data.authorId || isAdmin());
    }

    // ── Wills (FIX: was missing, defaulted to deny) ──
    match /wills/{willId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.authorId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recipientCount']) ||
        isAdmin()
      );
      allow delete: if isAuth() && (request.auth.uid == resource.data.authorId || isAdmin());
    }

    // ── Reports ──
    match /reports/{reportId} {
      allow create: if isAuth()
                    && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── Notifications ──
    match /notifications/{notifId} {
      allow read: if isAuth()
                  && (request.auth.uid == resource.data.toUid
                      || request.auth.uid == resource.data.recipientId);
      allow create: if isAuth()
                    && (request.resource.data.recipientId is string
                        || request.resource.data.toUid is string);
      allow delete: if isAuth()
                    && (request.auth.uid == resource.data.toUid
                        || request.auth.uid == resource.data.recipientId
                        || isAdmin());
      allow update: if isAuth()
                    && (request.auth.uid == resource.data.toUid
                        || request.auth.uid == resource.data.recipientId);
    }

    // ── Trainer Profiles ──
    match /trainerProfiles/{uid} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == uid;
    }

    // ── Training Sessions ──
    match /trainingSessions/{sessionId} {
      function isParticipant() {
        return request.auth.uid == resource.data.trainerId
            || request.auth.uid == resource.data.traineeId;
      }
      function isParticipantOnCreate() {
        return request.auth.uid == request.resource.data.trainerId
            || request.auth.uid == request.resource.data.traineeId;
      }
      allow read: if isAuth() && (isParticipant() || isAdmin());
      allow create: if isAuth() && isParticipantOnCreate();
      allow update: if isAuth() && (isParticipant() || isAdmin());
      allow delete: if isAuth() && (request.auth.uid == resource.data.trainerId || isAdmin());
    }

    // ── Admin collection group reads ──
    // Allows admin to query workoutLogs and runningRoutes across ALL users in one collectionGroup call
    match /{path=**}/workoutLogs/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/runningRoutes/{docId} {
      allow read: if isAdmin();
    }

    // ── Live Run Sessions ──
    // Public read — anyone with the share link can follow a live run
    match /runLiveSessions/{sessionId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && request.auth.uid == resource.data.uid;
      allow delete: if isAuth() && request.auth.uid == resource.data.uid;
    }

    // ── Watch pairing — Watch polls without auth; only server writes via Admin SDK ──
    match /watchPairings/{code} {
      allow read: if true;
      allow write: if false;
    }

    // ── Config (feature flags) ──
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Bot moderation logs ──
    match /botLogs/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ── Client-side error logs ──
    match /errorLogs/{docId} {
      allow create: if isAuth();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── Analytics ──
    match /analytics/{docId} {
      allow read: if isAdmin();
      // Aggregate counters (pageViews, activeUsers) + session docs (uid, date)
      allow create, update: if isAuth()
        && request.resource.data.keys().hasOnly([
             'pageViews', 'activeUsers', 'uid', 'date'
           ]);
      allow delete: if isAdmin();
    }
  }
}
