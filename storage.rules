rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // All uploaded media — public read, authenticated write up to 200 MB
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
