rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatar uploads — only the owner can write, 10 MB max, images only
    match /uploads/avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // User media uploads — only the owner can write to their own folder
    match /uploads/media/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 500 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
    }

    // Ad media uploads — only the advertiser can write to their folder
    match /ads/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 500 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
    }

    // Chat image attachments — any authenticated user can upload, 25 MB max, images only
    match /chat-media/{chatId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Chat voice messages — any authenticated user can upload, 10 MB max, audio only
    match /chat-audio/{chatId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    // AI Studio — image/video transforms, owner read/write only
    match /ai-studio/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // Profile pictures (legacy path from older app versions)
    match /profilePictures/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Post videos (legacy path from older app versions)
    match /videos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 200 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    // Watermarked videos + thumbnails — written by Cloud Functions, read by anyone
    match /watermarked/{userId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /thumbnails/{userId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Catch-all deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
